{
  "name": "vvvv",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .vue,.js,.jsx,.cjs,.mjs src --fix",
    "format": "prettier --write src/",
    "prepare": "husky install",
    "publishMajor": "cd ./src/CesiumSDK && npm run build && npm run major && npm publish",
    "publishMinor": "cd ./src/CesiumSDK && npm run build && npm run minor && npm publish",
    "publishPatch": "cd ./src/CesiumSDK && npm run build && npm run patch && npm publish"
  },
  "dependencies": {
    "cesium-plugins-fn": "^4.2.2",
    "element-plus": "^2.10.2",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^9.32.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "lint-staged": "^16.1.4",
    "prettier": "^3.6.2",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.7.0",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
